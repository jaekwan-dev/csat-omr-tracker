generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id        String   @id // 학번 (예: "1101")
  name      String
  pinCode   String   @default("0000")
  grade     Int
  classNum  Int
  submissions Submission[]
}

model Exam {
  id              Int      @id @default(autoincrement())
  subject         Subject
  title           String   // "1회차", "2024-06"
  totalQuestions  Int
  startNum        Int      @default(1)
  explanationPdfUrl String? // 해설지 PDF 다운로드 링크
  questions       Question[]
  submissions     Submission[]
}

enum Subject {
  KOREAN
  MATH
  ENGLISH
}

model Question {
  id            Int     @id @default(autoincrement())
  examId        Int
  exam          Exam    @relation(fields: [examId], references: [id])
  questionNum   Int
  isSubjective  Boolean @default(false)
  correctAnswer Int     // 객관식: 1-5, 주관식: 0-999
  score         Int
}

model Submission {
  id          Int      @id @default(autoincrement())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  examId      Int
  exam        Exam     @relation(fields: [examId], references: [id])
  answers     Json     // {"1": 2, "2": 5, ...}
  totalScore  Int
  submittedAt DateTime @default(now())

  @@unique([studentId, examId])
}
